//! DNS tab - Automated DNS management with Cloudflare OAuth
//!
//! This tab provides automated DNS setup through Cloudflare OAuth workflow:
//! 1. OAuth authentication with PKCE
//! 2. Domain registration/connection via Cloudflare Registrar API
//! 3. GCP VM integration for automatic NS record configuration
//! 4. DNS verification and HTTPS connection testing

use crate::{dure_debug, dure_error, dure_info, dure_warn};
use eframe::egui;
use egui_i18n::tr;
use egui_material3::datatable::data_table;
use egui_material3::{badge, dialog, BadgeColor, BadgeSize, MaterialButton};
use poll_promise::Promise;
use std::cell::Cell;

use crate::calc::profile::ProfileContext;
use crate::ui_dlg::dns::{HttpsCheckDialog, NsCheckDialog};

// Button spacing matching Platform tab
const BUTTON_VERTICAL_SPACING: f32 = 4.0;
const BUTTON_HORIZONTAL_SPACING: f32 = 4.0;

/// Operation state for visual feedback with timestamps
#[derive(Debug, Clone, PartialEq)]
pub enum OperationState {
    Idle,
    InProgress {
        operation: String,
        started_at: i64, // Unix timestamp
    },
    Completed {
        operation: String,
        completed_at: i64,
    },
    Failed {
        operation: String,
        error: String,
        failed_at: i64,
    },
}

impl OperationState {
    pub fn start(operation: impl Into<String>) -> Self {
        Self::InProgress {
            operation: operation.into(),
            started_at: chrono::Utc::now().timestamp(),
        }
    }

    pub fn complete(self) -> Self {
        if let Self::InProgress { operation, .. } = self {
            Self::Completed {
                operation,
                completed_at: chrono::Utc::now().timestamp(),
            }
        } else {
            self
        }
    }

    pub fn fail(self, error: impl Into<String>) -> Self {
        if let Self::InProgress { operation, .. } = self {
            Self::Failed {
                operation,
                error: error.into(),
                failed_at: chrono::Utc::now().timestamp(),
            }
        } else {
            self
        }
    }

    pub fn reset(&mut self) {
        *self = Self::Idle;
    }
}

impl Default for OperationState {
    fn default() -> Self {
        Self::Idle
    }
}

/// DNS tab state
#[cfg_attr(feature = "serde", derive(serde::Deserialize, serde::Serialize))]
pub struct DnsTab {
    /// Selected domain for operations
    #[cfg_attr(feature = "serde", serde(skip))]
    selected_domain: Option<String>,

    /// Domain rows for table display
    #[cfg_attr(feature = "serde", serde(skip))]
    domain_rows: Vec<DnsDomainRow>,

    /// Show "Add DNS" wizard dialog
    #[cfg_attr(feature = "serde", serde(skip))]
    show_add_dns_wizard: bool,

    /// DNS wizard state
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_wizard: Option<crate::ui_dlg::dns_wizard::DnsWizard>,

    /// NS check dialog
    #[cfg_attr(feature = "serde", serde(skip))]
    ns_check_dialog: NsCheckDialog,

    /// Show DNS settings check dialog
    #[cfg_attr(feature = "serde", serde(skip))]
    show_dns_settings_dialog: bool,

    /// DNS settings check result
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_settings_result: Option<(SettingsCheckResult, Vec<String>)>,

    /// HTTPS check dialog
    #[cfg_attr(feature = "serde", serde(skip))]
    https_check_dialog: HttpsCheckDialog,

    /// NS check promise
    #[cfg_attr(feature = "serde", serde(skip))]
    ns_check_promise:
        Option<Promise<Result<(NsCheckResult, Vec<String>), (NsCheckResult, Vec<String>)>>>,

    /// DNS settings check promise
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_settings_promise: Option<
        Promise<Result<(SettingsCheckResult, Vec<String>), (SettingsCheckResult, Vec<String>)>>,
    >,

    /// HTTPS check promise
    #[cfg_attr(feature = "serde", serde(skip))]
    https_check_promise: Option<Promise<Result<HttpsCheckResult, String>>>,

    /// Flag to track if domain rows have been loaded from config
    #[cfg_attr(feature = "serde", serde(skip))]
    loaded: bool,

    /// OAuth result for DNS settings check re-authentication
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_oauth_result: Option<crate::api::cloudflare::oauth::OAuthResult>,

    /// OAuth promise for DNS settings check
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_oauth_promise: Option<Promise<Result<crate::api::cloudflare::oauth::OAuthResult, String>>>,

    /// DNS records creation promise
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_create_promise: Option<Promise<Result<(), String>>>,

    /// DNS operation log for settings check dialog
    #[cfg_attr(feature = "serde", serde(skip))]
    dns_operation_log: Vec<String>,
}

/// Domain row data for table
#[derive(Clone, Debug)]
pub struct DnsDomainRow {
    pub provider: String,     // "cloudflare"
    pub domain: String,       // "dure.co"
    pub status: DomainStatus, // Configured, Pending, Error

    // Platform/VM binding
    pub platform_id: Option<String>,
    pub platform_name: Option<String>,
    pub vm_name: Option<String>,
    pub vm_external_ip: Option<String>,

    // Provider metadata
    pub account_id: Option<String>,
    pub zone_id: Option<String>, // Cloudflare zone ID

    // OAuth tokens (from wizard OAuth flow)
    pub oauth_access_token: Option<String>,
    pub oauth_refresh_token: Option<String>,
    pub oauth_token_expiry: Option<u64>,
    pub oauth_refresh_failed: bool, // OAuth token expired and refresh failed

    // Check results
    pub last_ns_check: Option<NsCheckResult>,
    pub last_settings_check: Option<SettingsCheckResult>,
    pub last_https_check: Option<HttpsCheckResult>,

    // Operation state tracking
    pub operation_state: OperationState,

    // Drawer state
    pub drawer_state: DnsDrawerState,
}

/// Domain status
#[derive(Clone, Debug, PartialEq)]
enum DomainStatus {
    Configured,
    Pending,
    Error(String),
}

/// DNS record check result
#[derive(Clone, Debug)]
struct DnsRecordCheck {
    record_type: String,    // "A", "CNAME", "SRV"
    name: String,           // "dure.co", "www.dure.co"
    expected: String,       // Expected value
    actual: Option<String>, // Actual value from DNS
    valid: bool,            // true if matches expected
}

/// HTTPS connection check result

/// NS check result
#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
pub struct NsCheckResult {
    pub checked_at: i64,
    pub uses_cloudflare: bool,
    pub nameservers: Vec<String>,
    pub error: Option<String>,
}

/// DNS record display format
#[derive(Clone, Debug)]
pub struct DnsRecordDisplay {
    pub name: String,        // "dure.co" or "xmpp.dure.co"
    pub record_type: String, // "A", "CNAME", "SRV"
    pub value: String,       // "1.2.3.4" or "dure.co"
}

/// DNS settings check result
#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
pub struct SettingsCheckResult {
    pub checked_at: i64,
    pub records_valid: bool,
    pub missing_records: Vec<String>,
    pub error: Option<String>,
    #[serde(default)]
    pub fetched_records: Vec<DnsRecordDisplay>, // Actual records from Cloudflare
}

impl serde::Serialize for DnsRecordDisplay {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer,
    {
        use serde::ser::SerializeStruct;
        let mut state = serializer.serialize_struct("DnsRecordDisplay", 3)?;
        state.serialize_field("name", &self.name)?;
        state.serialize_field("record_type", &self.record_type)?;
        state.serialize_field("value", &self.value)?;
        state.end()
    }
}

impl<'de> serde::Deserialize<'de> for DnsRecordDisplay {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        #[derive(serde::Deserialize)]
        struct Helper {
            name: String,
            record_type: String,
            value: String,
        }
        let helper = Helper::deserialize(deserializer)?;
        Ok(DnsRecordDisplay {
            name: helper.name,
            record_type: helper.record_type,
            value: helper.value,
        })
    }
}

/// Drawer state for DNS domain
#[derive(Clone, Debug)]
pub struct DnsDrawerState {
    pub active_tab: DnsDrawerTab,
    pub logs: Vec<String>,
    pub operations: Vec<crate::storage::models::opslog::OperationLog>,
    pub loading: bool,
}

impl Default for DnsDrawerState {
    fn default() -> Self {
        Self {
            active_tab: DnsDrawerTab::Status,
            logs: Vec::new(),
            operations: Vec::new(),
            loading: false,
        }
    }
}

impl DnsDrawerState {
    pub fn new() -> Self {
        Self::default()
    }

    pub fn switch_tab(&mut self, tab: DnsDrawerTab) {
        self.active_tab = tab;
    }

    pub fn set_logs(&mut self, logs: Vec<String>) {
        self.logs = logs;
        self.loading = false;
    }

    pub fn set_operations(&mut self, ops: Vec<crate::storage::models::opslog::OperationLog>) {
        self.operations = ops;
        self.loading = false;
    }

    pub fn set_loading(&mut self, loading: bool) {
        self.loading = loading;
    }
}

/// Drawer tabs for DNS domain
#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
pub enum DnsDrawerTab {
    #[default]
    Status,
    Logs,
    Operations,
}

impl DnsDrawerTab {
    pub fn to_index(&self) -> usize {
        match self {
            DnsDrawerTab::Status => 0,
            DnsDrawerTab::Logs => 1,
            DnsDrawerTab::Operations => 2,
        }
    }

    pub fn from_index(index: usize) -> Self {
        match index {
            0 => DnsDrawerTab::Status,
            1 => DnsDrawerTab::Logs,
            2 => DnsDrawerTab::Operations,
            _ => DnsDrawerTab::default(),
        }
    }
}

// Tab string constants (not user-facing, only for internal identification)
const TAB_STATUS: &str = "status";
const TAB_LOGS: &str = "logs";
const TAB_OPERATIONS: &str = "operations";

impl crate::ui_components::drawer::DrawerTabTrait for DnsDrawerTab {
    fn as_str(&self) -> &'static str {
        match self {
            DnsDrawerTab::Status => TAB_STATUS,
            DnsDrawerTab::Logs => TAB_LOGS,
            DnsDrawerTab::Operations => TAB_OPERATIONS,
        }
    }

    fn all() -> &'static [Self] {
        &[
            DnsDrawerTab::Status,
            DnsDrawerTab::Logs,
            DnsDrawerTab::Operations,
        ]
    }
}

impl Default for DnsTab {
    fn default() -> Self {
        Self {
            selected_domain: None,
            domain_rows: Vec::new(),
            show_add_dns_wizard: false,
            dns_wizard: None,
            ns_check_dialog: NsCheckDialog::new(),
            show_dns_settings_dialog: false,
            dns_settings_result: None,
            https_check_dialog: HttpsCheckDialog::new(),
            ns_check_promise: None,
            dns_settings_promise: None,
            https_check_promise: None,
            loaded: false,
            dns_oauth_result: None,
            dns_oauth_promise: None,
            dns_create_promise: None,
            dns_operation_log: Vec::new(),
        }
    }
}

/// Helper function to refresh OAuth token (can be called from Promise thread)
///
/// Returns (access_token, expires_at, refresh_token) on success
fn refresh_oauth_token_standalone(
    domain: &str,
    refresh_token: &str,
    config_path: &std::path::PathBuf,
) -> Result<(String, u64, String), String> {
    if refresh_token.is_empty() {
        return Err("No refresh token available".to_string());
    }

    dure_info!(
        "OAuth token expired, attempting auto-refresh for domain: {}",
        domain
    );

    // Use Cloudflare OAuth refresh (PKCE flow - no client secret needed)
    use crate::api::cloudflare::oauth;

    let oauth_result = oauth::refresh_access_token(refresh_token)
        .map_err(|e| format!("Token refresh failed: {}", e))?;

    // Update config with new token
    if let Ok(mut config) = crate::config::AppConfig::load(config_path) {
        if let Some(dns_domain) = config.dns_domains.iter_mut().find(|d| d.domain == domain) {
            dns_domain.oauth_access_token = Some(oauth_result.access_token.clone());
            dns_domain.oauth_refresh_token = oauth_result.refresh_token.clone();
            dns_domain.oauth_token_expiry = Some(oauth_result.expires_at);

            if let Err(e) = config.save(config_path) {
                dure_error!("Failed to save refreshed token to config: {}", e);
                return Err(format!("Config save failed: {}", e));
            }

            dure_info!("✓ OAuth token refreshed and saved to config");
        } else {
            return Err("Domain not found in config".to_string());
        }
    } else {
        return Err("Failed to load config".to_string());
    }

    // Per Cloudflare OAuth: new refresh_token MUST be present (rotation is mandatory)
    let new_refresh_token = oauth_result
        .refresh_token
        .ok_or_else(|| "Cloudflare did not return new refresh_token".to_string())?;

    Ok((
        oauth_result.access_token,
        oauth_result.expires_at,
        new_refresh_token,
    ))
}

impl DnsTab {
    /// Render the DNS tab
    pub fn ui(&mut self, ui: &mut egui::Ui, profile: &ProfileContext) {
        // Load DNS domains from config on first render
        if !self.loaded {
            self.load_domain_rows(profile);
        }

        ui.vertical(|ui| {
            // Header with "Add DNS" button
            //ui.add_space(10.0);

            // Domain table
            self.render_domain_table(ui, profile);

            // Check for button click events stored in ui.data (consume with remove_temp)
            let reauth =
                ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_action_reauth")));
            let refresh_all =
                ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_refresh_all")));
            let check_ns = ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_check_ns")));
            let check_settings =
                ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_check_settings")));
            let check_https =
                ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_check_https")));
            let delete_domain =
                ui.data_mut(|d| d.remove_temp::<String>(egui::Id::new("dns_delete_domain")));

            if let Some(domain) = reauth {
                // Open DNS wizard in re-auth mode
                dure_info!("Opening DNS wizard in re-auth mode for domain: {}", domain);
                let mut wizard =
                    crate::ui_dlg::dns_wizard::DnsWizard::new_reauth(profile.name.clone(), domain);

                // Load platforms from config
                let platforms = Self::load_platforms_from_config(&profile.config_file);
                wizard.load_available_platforms(platforms);

                self.dns_wizard = Some(wizard);
                self.show_add_dns_wizard = true;
            }
            if let Some(domain) = refresh_all {
                // Run all 3 checks in background (no dialogs)
                self.check_ns_server_impl(&domain, false);
                self.check_dns_settings_impl(&domain, false, profile);
                self.check_https_connection_impl(&domain, false);
            }
            if let Some(domain) = check_ns {
                self.check_ns_server(&domain);
            }
            if let Some(domain) = check_settings {
                self.check_dns_settings(&domain, profile);
            }
            if let Some(domain) = check_https {
                self.check_https_connection(&domain);
            }
            if let Some(domain) = delete_domain {
                self.delete_domain(&domain, profile);
            }

            // Handle drawer tab switches
            for row in &mut self.domain_rows {
                if let Some((domain, new_tab)) = ui.data_mut(|d| {
                    d.remove_temp::<(String, DnsDrawerTab)>(
                        egui::Id::new("dns_drawer_tab_switch").with(&row.domain),
                    )
                }) {
                    if domain == row.domain {
                        row.drawer_state.active_tab = new_tab;
                    }
                }
            }

            // Dialogs
            self.render_dialogs(ui, profile);
        });
    }

    /// Render domain table
    fn render_domain_table(&mut self, ui: &mut egui::Ui, profile: &ProfileContext) {
        // Calculate responsive column widths
        let available_width = ui.available_width() - 40.0;
        let base_width = 740.0;
        let width_ratio = (available_width / base_width).min(1.5).max(0.8);

        egui::ScrollArea::vertical().show(ui, |ui| {
            ui.heading(tr!("dns-main-heading"));
            ui.add_space(4.0);
            ui.label(tr!("dns-main-desc"));
            ui.add_space(8.0);

            if ui
                .add(MaterialButton::filled(tr!("dns-button-add")))
                .on_hover_text(tr!("dns-button-add-tooltip"))
                .clicked()
            {
                self.show_add_dns_wizard = true;
                let mut wizard = crate::ui_dlg::dns_wizard::DnsWizard::new(profile.name.clone());

                // Load platforms from config
                let platforms = Self::load_platforms_from_config(&profile.config_file);
                wizard.load_available_platforms(platforms);

                self.dns_wizard = Some(wizard);
            }
            ui.add_space(8.0);

            if self.domain_rows.is_empty() {
                ui.label(tr!("dns-main-empty"));
                // Add blank space to ensure log panel appears at bottom (>500px)
                ui.add_space(520.0);
                return;
            }

            // Build data table
            let table_id = egui::Id::new("dns_domains_table");

            let mut table = data_table()
                .id(table_id)
                .allow_selection(false)
                .allow_drawer(true)
                .min_row_height(68.0)
                .drawer_row_height(400.0)
                .column(tr!("dns-table-col-dns"), 230.0 * width_ratio, false)
                .column(tr!("dns-table-col-operations"), 510.0 * width_ratio, false);

            for row in self.domain_rows.clone().iter() {
                let row_for_cells = row.clone();
                let row_for_ops = row.clone();
                let row_for_drawer = row.clone();

                table = table.row(move |r| {
                    r.cell_widget(move |ui| {
                        // DNS column: badge + domain name
                        ui.vertical(|ui| {
                            ui.add(
                                badge(&row_for_cells.provider)
                                    .color(BadgeColor::Primary)
                                    .size(BadgeSize::Small),
                            );
                            use egui_material3::theme::get_global_color;
                            ui.label(
                                egui::RichText::new(&row_for_cells.domain)
                                    .size(16.0)
                                    .strong()
                                    .color(get_global_color("onSurface")),
                            );
                        });
                    })
                    .cell_widget(move |ui| {
                        // Operations column: buttons
                        use egui_material3::linear_progress;

                        ui.spacing_mut().item_spacing.x = BUTTON_HORIZONTAL_SPACING;
                        ui.spacing_mut().item_spacing.y = BUTTON_VERTICAL_SPACING;

                        let domain = row_for_ops.domain.clone();
                        let operation_in_progress = matches!(
                            row_for_ops.operation_state,
                            OperationState::InProgress { .. }
                        );

                        ui.vertical(|ui| {
                            let overlay_pos = ui.cursor().min;
                            let column_width = ui.available_width();

                            ui.horizontal_wrapped(|ui| {
                                // Re-Auth button (shown when OAuth refresh fails)
                                if row_for_ops.oauth_refresh_failed {
                                    if ui
                                        .add(
                                            MaterialButton::filled(tr!("platform-button-reauth"))
                                                .small(),
                                        )
                                        .on_hover_text(tr!("platform-button-reauth-tooltip"))
                                        .clicked()
                                    {
                                        ui.data_mut(|d| {
                                            d.insert_temp(
                                                egui::Id::new("dns_action_reauth"),
                                                domain.clone(),
                                            )
                                        });
                                    }
                                }

                                // Other operations (disabled when OAuth fails)
                                ui.add_enabled_ui(
                                    !operation_in_progress && !row_for_ops.oauth_refresh_failed,
                                    |ui| {
                                        // Refresh button (first position)
                                        if ui
                                            .add(
                                                MaterialButton::outlined(tr!("dns-button-refresh"))
                                                    .small(),
                                            )
                                            .on_hover_text(tr!("dns-button-refresh-tooltip"))
                                            .clicked()
                                        {
                                            ui.data_mut(|d| {
                                                d.insert_temp(
                                                    egui::Id::new("dns_refresh_all"),
                                                    domain.clone(),
                                                )
                                            });
                                        }

                                        if ui
                                            .add(
                                                MaterialButton::outlined(tr!(
                                                    "dns-button-check-ns"
                                                ))
                                                .small(),
                                            )
                                            .on_hover_text(tr!("dns-button-check-ns-tooltip"))
                                            .clicked()
                                        {
                                            ui.data_mut(|d| {
                                                d.insert_temp(
                                                    egui::Id::new("dns_check_ns"),
                                                    domain.clone(),
                                                )
                                            });
                                        }

                                        if ui
                                            .add(
                                                MaterialButton::outlined(tr!(
                                                    "dns-button-check-settings"
                                                ))
                                                .small(),
                                            )
                                            .on_hover_text(tr!("dns-button-check-settings-tooltip"))
                                            .clicked()
                                        {
                                            ui.data_mut(|d| {
                                                d.insert_temp(
                                                    egui::Id::new("dns_check_settings"),
                                                    domain.clone(),
                                                )
                                            });
                                        }

                                        if ui
                                            .add(
                                                MaterialButton::outlined(tr!(
                                                    "dns-button-https-check"
                                                ))
                                                .small(),
                                            )
                                            .on_hover_text(tr!("dns-button-https-check-tooltip"))
                                            .clicked()
                                        {
                                            ui.data_mut(|d| {
                                                d.insert_temp(
                                                    egui::Id::new("dns_check_https"),
                                                    domain.clone(),
                                                )
                                            });
                                        }
                                    },
                                );

                                // Delete button (always enabled, even during re-auth)
                                if ui
                                    .add(MaterialButton::outlined(tr!("dns-button-delete")).small())
                                    .on_hover_text(tr!("dns-button-delete-tooltip"))
                                    .clicked()
                                {
                                    ui.data_mut(|d| {
                                        d.insert_temp(
                                            egui::Id::new("dns_delete_domain"),
                                            domain.clone(),
                                        )
                                    });
                                }
                            }); // Close ui.horizontal_wrapped

                            // Overlay progress on foreground layer
                            if operation_in_progress {
                                let current_area_id = ui.layer_id().id;
                                let foreground_layer =
                                    egui::LayerId::new(egui::Order::Foreground, current_area_id);

                                ui.with_layer_id(foreground_layer, |ui| {
                                    use egui_material3::theme::get_global_color;
                                    let progress_rect = egui::Rect::from_min_size(
                                        overlay_pos,
                                        egui::vec2(column_width, 30.0),
                                    );
                                    let overlay_color = get_global_color("surfaceContainer");
                                    ui.painter().rect_filled(
                                        progress_rect,
                                        egui::Rounding::same(4),
                                        overlay_color,
                                    );

                                    ui.allocate_ui_at_rect(progress_rect, |ui| {
                                        ui.add_space(2.0);
                                        if let OperationState::InProgress { operation, .. } =
                                            &row_for_ops.operation_state
                                        {
                                            ui.label(operation);
                                        }
                                        ui.add(
                                            linear_progress()
                                                .indeterminate(true)
                                                .width(column_width - 20.0)
                                                .height(4.0)
                                                .four_color_enabled(true),
                                        );
                                    });
                                });
                            }
                        }); // Close ui.vertical
                    })
                    .drawer(move |ui| {
                        // Drawer with tabs
                        let mut tab_switch = None;
                        crate::ui_tabs::dns_drawer::render_drawer(
                            ui,
                            &row_for_drawer,
                            &row_for_drawer.drawer_state,
                            &mut tab_switch,
                        );

                        if let Some(new_tab) = tab_switch {
                            ui.data_mut(|d| {
                                d.insert_temp(
                                    egui::Id::new("dns_drawer_tab_switch")
                                        .with(&row_for_drawer.domain),
                                    (row_for_drawer.domain.clone(), new_tab),
                                );
                            });
                        }
                    })
                });
            }

            table.show(ui);
        });
    }

    /// Check NS server records using DNS over HTTPS
    fn check_ns_server(&mut self, domain: &str) {
        self.check_ns_server_impl(domain, true);
    }

    fn check_ns_server_impl(&mut self, domain: &str, show_dialog: bool) {
        dure_info!("Checking NS server for domain: {}", domain);

        // Set operation state to InProgress
        if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
            row.operation_state = OperationState::start(tr!("dns-operation-check-ns"));
        }

        // Store which domain is being checked
        self.selected_domain = Some(domain.to_string());

        let domain = domain.to_string();
        let promise = Promise::spawn_thread("check_ns", move || {
            // Use DNS-over-HTTPS (Cloudflare 1.1.1.1)
            let url = format!("https://1.1.1.1/dns-query?name={}&type=NS", domain);

            match ureq::get(&url)
                .set("Accept", "application/dns-json")
                .timeout(std::time::Duration::from_secs(5))
                .call()
            {
                Ok(response) => {
                    #[derive(serde::Deserialize)]
                    struct DnsResponse {
                        #[serde(rename = "Answer")]
                        answer: Option<Vec<DnsAnswer>>,
                    }

                    #[derive(serde::Deserialize)]
                    struct DnsAnswer {
                        data: String,
                    }

                    match response.into_json::<DnsResponse>() {
                        Ok(dns_resp) => {
                            if let Some(answers) = dns_resp.answer {
                                let nameservers: Vec<String> = answers
                                    .iter()
                                    .map(|a| a.data.trim_end_matches('.').to_string())
                                    .collect();

                                // Check if using Cloudflare nameservers
                                let uses_cloudflare = nameservers
                                    .iter()
                                    .any(|ns| ns.ends_with(".ns.cloudflare.com"));

                                let mut results = Vec::new();
                                results.push(tr!("dns-check-ns-found", {count: nameservers.len()}));
                                for ns in &nameservers {
                                    results.push(format!("  {}", ns));
                                }

                                Ok((
                                    NsCheckResult {
                                        checked_at: chrono::Utc::now().timestamp(),
                                        uses_cloudflare,
                                        nameservers,
                                        error: None,
                                    },
                                    results,
                                ))
                            } else {
                                Err((
                                    NsCheckResult {
                                        checked_at: chrono::Utc::now().timestamp(),
                                        uses_cloudflare: false,
                                        nameservers: Vec::new(),
                                        error: Some(tr!("dns-check-ns-none")),
                                    },
                                    vec![format!("✗ {}", tr!("dns-check-ns-none"))],
                                ))
                            }
                        }
                        Err(e) => {
                            let err_msg = format!("Failed to parse DNS response: {}", e);
                            Err((
                                NsCheckResult {
                                    checked_at: chrono::Utc::now().timestamp(),
                                    uses_cloudflare: false,
                                    nameservers: Vec::new(),
                                    error: Some(err_msg.clone()),
                                },
                                vec![format!("✗ {}", err_msg)],
                            ))
                        }
                    }
                }
                Err(e) => {
                    let err_msg = format!("DNS query failed: {}", e);
                    Err((
                        NsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            uses_cloudflare: false,
                            nameservers: Vec::new(),
                            error: Some(err_msg.clone()),
                        },
                        vec![format!("✗ {}", err_msg)],
                    ))
                }
            }
        });

        self.ns_check_promise = Some(promise);
        if show_dialog {
            self.ns_check_dialog.open = true;
        }
    }

    /// Start OAuth authentication for DNS settings check
    fn start_dns_oauth(&mut self, domain: &str) {
        dure_info!("Starting DNS OAuth for domain: {}", domain);

        let domain = domain.to_string();
        self.dns_operation_log.push(tr!("dns-oauth-starting"));

        let promise = Promise::spawn_thread("dns_oauth", move || {
            use crate::api::cloudflare::oauth::CloudflareOAuthHandler;

            let handler = CloudflareOAuthHandler::new();
            handler
                .run_oauth_flow()
                .map_err(|e| format!("OAuth failed: {}", e))
        });

        self.dns_oauth_promise = Some(promise);
    }

    /// Create DNS records for domain using OAuth token
    fn create_dns_records_for_domain(
        &mut self,
        domain: &str,
        zone_id: &str,
        vm_ip: &str,
        access_token: &str,
    ) {
        dure_info!("Creating DNS records for domain: {}", domain);

        let domain = domain.to_string();
        let zone_id = zone_id.to_string();
        let vm_ip = vm_ip.to_string();
        let access_token = access_token.to_string();

        self.dns_operation_log.push(tr!("dns-create-starting"));

        let promise = Promise::spawn_thread("create_dns_records", move || {
            use crate::api::cloudflare::dns::CloudflareClient;

            let client = CloudflareClient::new(access_token);
            client
                .create_default_xmpp_records(&zone_id, &domain, &vm_ip)
                .map_err(|e| format!("Create failed: {}", e))
        });

        self.dns_create_promise = Some(promise);
    }

    /// Update domain OAuth tokens in config and domain row
    fn update_domain_oauth_tokens(
        &mut self,
        domain: &str,
        access_token: String,
        refresh_token: Option<String>,
        expires_at: u64,
        profile: &ProfileContext,
    ) {
        // Update domain row
        if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
            row.oauth_access_token = Some(access_token.clone());
            row.oauth_refresh_token = refresh_token.clone();
            row.oauth_token_expiry = Some(expires_at);
        }

        // Update config file
        let config_path = profile.config_file.clone();
        if let Ok(mut config) = crate::config::AppConfig::load(&config_path) {
            if let Some(dns_domain) = config.dns_domains.iter_mut().find(|d| d.domain == domain) {
                dns_domain.oauth_access_token = Some(access_token);
                dns_domain.oauth_refresh_token = refresh_token;
                dns_domain.oauth_token_expiry = Some(expires_at);

                if let Err(e) = config.save(&config_path) {
                    dure_error!("Failed to save OAuth tokens to config: {}", e);
                }
            }
        }
    }

    /// Refresh OAuth token using refresh_token
    ///
    /// Returns (access_token, expires_at) on success
    ///
    /// Note: This is a simplified method used in tests. Production code uses
    /// refresh_oauth_token_standalone which also saves to config.
    fn refresh_dns_oauth_token(
        &self,
        domain: &str,
        refresh_token: Option<&str>,
    ) -> Result<(String, u64), String> {
        // Validate refresh_token
        let refresh_tok = match refresh_token {
            Some(t) if !t.is_empty() => t,
            _ => return Err("No refresh token available".to_string()),
        };

        // Check domain exists
        if !self.domain_rows.iter().any(|r| r.domain == domain) {
            return Err("Domain not found in config".to_string());
        }

        dure_info!(
            "OAuth token expired, attempting auto-refresh for domain: {}",
            domain
        );

        // Use Cloudflare OAuth refresh (PKCE flow - no client secret needed)
        use crate::api::cloudflare::oauth;

        let oauth_result = oauth::refresh_access_token(refresh_tok)
            .map_err(|e| format!("Token refresh failed: {}", e))?;

        // Verify new refresh_token was returned (per Cloudflare OAuth conventions)
        if oauth_result.refresh_token.is_none() {
            return Err("Token refresh failed: Cloudflare did not return new refresh_token".to_string());
        }

        dure_info!("✓ OAuth token refreshed successfully");

        Ok((oauth_result.access_token, oauth_result.expires_at))
    }

    /// Check DNS settings via Cloudflare API
    fn check_dns_settings(&mut self, domain: &str, profile: &ProfileContext) {
        self.check_dns_settings_impl(domain, true, profile);
    }

    fn check_dns_settings_impl(
        &mut self,
        domain: &str,
        show_dialog: bool,
        profile: &ProfileContext,
    ) {
        dure_info!("Checking DNS settings for domain: {}", domain);

        // Set operation state to InProgress
        if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
            row.operation_state = OperationState::start(tr!("dns-operation-check-settings"));
        }

        // Get domain row data (zone_id, vm_ip, oauth_access_token, token_expiry, refresh_token)
        let row = self.domain_rows.iter().find(|r| r.domain == domain);
        let zone_id = row.and_then(|r| r.zone_id.clone());
        let vm_ip = row.and_then(|r| r.vm_external_ip.clone());
        let mut access_token = row.and_then(|r| r.oauth_access_token.clone());
        let token_expiry = row.and_then(|r| r.oauth_token_expiry);
        let refresh_token = row.and_then(|r| r.oauth_refresh_token.clone());

        self.selected_domain = Some(domain.to_string());

        // Show cached result immediately if available (Task 3)
        if let Some(cached_check) = row.and_then(|r| r.last_settings_check.clone()) {
            let display_msgs = if cached_check.records_valid {
                vec![tr!("dns-settings-all-configured").to_string()]
            } else {
                vec!["⚠ DNS records missing or incorrect - click Setup DNS in wizard".to_string()]
            };
            self.dns_settings_result = Some((cached_check, display_msgs));
        }

        let domain = domain.to_string();
        let config_path = profile.config_file.clone();
        let promise = Promise::spawn_thread("check_dns_settings", move || {
            // Check if OAuth token expired and attempt auto-refresh
            if let Some(expiry) = token_expiry {
                let now = chrono::Utc::now().timestamp() as u64;
                if now > expiry {
                    let expired_ago = now - expiry;
                    dure_error!(
                        "OAuth token expired {} seconds ago (expiry: {}, now: {})",
                        expired_ago,
                        expiry,
                        now
                    );

                    // Debug: Check if refresh_token is available
                    dure_debug!("Refresh token available: {}", refresh_token.is_some());

                    // Attempt token refresh if refresh_token available
                    if let Some(ref refresh_tok) = refresh_token {
                        match refresh_oauth_token_standalone(&domain, refresh_tok, &config_path) {
                            Ok((new_access, new_expiry, _new_refresh)) => {
                                dure_info!("✓ Token auto-refreshed, retrying DNS check");
                                // Update access_token for this check
                                access_token = Some(new_access);
                                // Note: token_expiry not used below, so no need to update
                            }
                            Err(e) => {
                                dure_error!("Token refresh failed: {}", e);
                                return Err((
                                    SettingsCheckResult {
                                        checked_at: chrono::Utc::now().timestamp(),
                                        records_valid: false,
                                        missing_records: Vec::new(),
                                        error: Some(format!("Token refresh failed: {} - please re-authenticate via wizard", e)),
                                        fetched_records: Vec::new(),
                                    },
                                    vec![format!("✗ OAuth token expired and refresh failed - please re-add domain via DNS wizard")]
                                ));
                            }
                        }
                    } else {
                        // No refresh token, can't auto-refresh
                        dure_warn!(
                            "No refresh token available for domain - auto-refresh not possible"
                        );
                        return Err((
                            SettingsCheckResult {
                                checked_at: chrono::Utc::now().timestamp(),
                                records_valid: false,
                                missing_records: Vec::new(),
                                error: Some(format!("OAuth token expired {} seconds ago - no refresh token available", expired_ago)),
                                fetched_records: Vec::new(),
                            },
                            vec![format!("✗ OAuth token expired - please re-add domain via DNS wizard to enable auto-refresh")]
                        ));
                    }
                }
            }

            // Validate OAuth token
            let token = match access_token {
                Some(t) => t,
                None => {
                    dure_error!("No OAuth token found for domain");
                    return Err((
                        SettingsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            records_valid: false,
                            missing_records: Vec::new(),
                            error: Some(
                                "No OAuth token - please re-add domain via wizard".to_string(),
                            ),
                            fetched_records: Vec::new(),
                        },
                        vec!["✗ No OAuth token - re-add domain to refresh credentials".to_string()],
                    ));
                }
            };

            // Validate zone_id
            let zone_id = match zone_id {
                Some(id) => id,
                None => {
                    return Err((
                        SettingsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            records_valid: false,
                            missing_records: Vec::new(),
                            error: Some("No zone ID - add domain via wizard first".to_string()),
                            fetched_records: Vec::new(),
                        },
                        vec!["✗ No zone ID - please add domain via DNS wizard".to_string()],
                    ));
                }
            };

            // Validate VM IP
            let vm_ip = match vm_ip {
                Some(ip) => ip,
                None => {
                    return Err((
                        SettingsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            records_valid: false,
                            missing_records: Vec::new(),
                            error: Some("No VM IP - bind domain to platform first".to_string()),
                            fetched_records: Vec::new(),
                        },
                        vec!["✗ No VM IP - please bind domain to platform in wizard".to_string()],
                    ));
                }
            };

            // Call Cloudflare API to verify DNS records (with retry on 401/403)
            use crate::api::cloudflare::dns::CloudflareClient;
            let mut client = CloudflareClient::new(token.clone());

            // Fetch actual DNS records for display
            let fetched_records = match client.get_records(&zone_id) {
                Ok(records) => records
                    .iter()
                    .filter(|r| {
                        let rt = r.record_type.to_uppercase();
                        rt == "A" || rt == "CNAME" || rt == "SRV"
                    })
                    .map(|r| DnsRecordDisplay {
                        name: r.name.clone(),
                        record_type: r.record_type.to_uppercase(),
                        value: r.content.clone(),
                    })
                    .collect(),
                Err(e) => {
                    dure_warn!("Failed to fetch DNS records for display: {}", e);
                    Vec::new()
                }
            };

            let result = client.verify_default_xmpp_records(&zone_id, &domain, &vm_ip);

            // Retry once if 401/403 authentication error (token may have expired during call)
            let result = if let Err(ref e) = result {
                let err_msg = e.to_string();
                if (err_msg.contains("401")
                    || err_msg.contains("403")
                    || err_msg.contains("authentication failed"))
                    && refresh_token.is_some()
                {
                    dure_warn!("API returned 401/403 - attempting token refresh and retry");

                    // Attempt token refresh
                    if let Some(ref refresh_tok) = refresh_token {
                        match refresh_oauth_token_standalone(&domain, refresh_tok, &config_path) {
                            Ok((new_access, _new_expiry, _new_refresh)) => {
                                dure_info!("✓ Token refreshed after 401/403, retrying API call");
                                // Create new client with refreshed token and retry
                                client = CloudflareClient::new(new_access);
                                client.verify_default_xmpp_records(&zone_id, &domain, &vm_ip)
                            }
                            Err(refresh_err) => {
                                dure_error!("Token refresh failed after 401/403: {}", refresh_err);
                                // Return original error
                                result
                            }
                        }
                    } else {
                        // No refresh token available, return original error
                        result
                    }
                } else {
                    // Not an auth error, return original error
                    result
                }
            } else {
                // Success on first try
                result
            };

            match result {
                Ok(verified) => {
                    if verified {
                        Ok((
                            SettingsCheckResult {
                                checked_at: chrono::Utc::now().timestamp(),
                                records_valid: true,
                                missing_records: Vec::new(),
                                error: None,
                                fetched_records,
                            },
                            vec![tr!("dns-settings-all-configured").to_string()],
                        ))
                    } else {
                        Err((
                            SettingsCheckResult {
                                checked_at: chrono::Utc::now().timestamp(),
                                records_valid: false,
                                missing_records: vec![
                                    "Some records missing or incorrect".to_string()
                                ],
                                error: None,
                                fetched_records: fetched_records.clone(),
                            },
                            vec![
                                "⚠ DNS records missing or incorrect - click Setup DNS in wizard"
                                    .to_string(),
                            ],
                        ))
                    }
                }
                Err(e) => {
                    let err_msg = e.to_string();
                    let user_msg = if err_msg.contains("401")
                        || err_msg.contains("403")
                        || err_msg.contains("authentication")
                    {
                        "✗ Authentication failed - please re-add domain via DNS wizard".to_string()
                    } else {
                        format!("✗ Check failed: {}", err_msg)
                    };

                    Err((
                        SettingsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            records_valid: false,
                            missing_records: Vec::new(),
                            error: Some(err_msg),
                            fetched_records,
                        },
                        vec![user_msg],
                    ))
                }
            }
        });

        self.dns_settings_promise = Some(promise);
        self.dns_operation_log.clear();
        if show_dialog {
            self.show_dns_settings_dialog = true;
        }
    }

    /// Check HTTPS connection and verify IP resolution
    fn check_https_connection(&mut self, domain: &str) {
        self.check_https_connection_impl(domain, true);
    }

    fn check_https_connection_impl(&mut self, domain: &str, show_dialog: bool) {
        dure_info!("Checking HTTPS connection for domain: {}", domain);

        // Set operation state to InProgress
        if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
            row.operation_state = OperationState::start(tr!("dns-operation-check-https"));
        }

        // Find domain row to get expected VM IP
        let row = self.domain_rows.iter().find(|r| r.domain == domain);
        let expected_ip = row.and_then(|r| r.vm_external_ip.clone());

        self.selected_domain = Some(domain.to_string());

        let domain = domain.to_string();
        let promise = Promise::spawn_thread("check_https", move || {
            // Resolve domain IP using DoH
            #[derive(serde::Deserialize)]
            struct DnsResponse {
                #[serde(rename = "Answer")]
                answer: Option<Vec<DnsAnswer>>,
            }

            #[derive(serde::Deserialize)]
            struct DnsAnswer {
                data: String,
            }

            let resolved_ip =
                match ureq::get(&format!("https://1.1.1.1/dns-query?name={}&type=A", domain))
                    .set("Accept", "application/dns-json")
                    .timeout(std::time::Duration::from_secs(5))
                    .call()
                {
                    Ok(resp) => match resp.into_json::<DnsResponse>() {
                        Ok(dns_resp) => dns_resp
                            .answer
                            .and_then(|answers| answers.first().map(|a| a.data.clone())),
                        Err(e) => {
                            return Ok(HttpsCheckResult {
                                checked_at: chrono::Utc::now().timestamp(),
                                resolves_to_vm: false,
                                resolved_ip: None,
                                expected_ip,
                                error: Some(format!("DNS parse error: {}", e)),
                            });
                        }
                    },
                    Err(e) => {
                        return Ok(HttpsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            resolves_to_vm: false,
                            resolved_ip: None,
                            expected_ip,
                            error: Some(format!("DNS resolution failed: {}", e)),
                        });
                    }
                };

            // Compare resolved IP with expected VM IP
            let resolves_to_vm =
                if let (Some(ref resolved), Some(ref expected)) = (&resolved_ip, &expected_ip) {
                    resolved == expected
                } else {
                    false
                };

            Ok(HttpsCheckResult {
                checked_at: chrono::Utc::now().timestamp(),
                resolves_to_vm,
                resolved_ip,
                expected_ip,
                error: None,
            })
        });

        self.https_check_promise = Some(promise);
        if show_dialog {
            self.show_https_check_dialog = true;
        }
    }

    /// Render all dialogs
    fn render_dialogs(&mut self, ui: &mut egui::Ui, profile: &ProfileContext) {
        // Add DNS wizard
        if self.show_add_dns_wizard {
            if let Some(wizard) = &mut self.dns_wizard {
                let mut open = true;
                let ctx = ui.ctx().clone();

                let window_width = ctx.viewport_rect().width();
                let window_height = ctx.viewport_rect().height();

                dialog(
                    "add_dns_wizard_dialog",
                    "Add DNS - Automated Setup",
                    &mut open,
                )
                .min_width(350.0)
                .max_width(window_width - 40.0)
                .max_height(window_height - 40.0)
                .scrollable(true)
                .content(|ui, _open| {
                    wizard.ui(ui, profile);
                })
                .show(&ctx);

                // Close wizard if requested or window closed
                if !open || wizard.should_close {
                    // Check if wizard completed a domain setup
                    if let Some((
                        provider,
                        domain,
                        zone_id,
                        account_id,
                        access_token,
                        refresh_token,
                        expires_at,
                    )) = &wizard.completed_domain
                    {
                        // Extract platform/VM info from wizard
                        let (platform_id, platform_name, vm_name, vm_external_ip) =
                            wizard.get_selected_platform_info();

                        // Check if re-auth mode (domain already exists)
                        if let Some(existing_row) =
                            self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                        {
                            // Re-auth mode: update tokens in existing row
                            existing_row.oauth_access_token = access_token.clone();
                            existing_row.oauth_refresh_token = refresh_token.clone();
                            existing_row.oauth_token_expiry = *expires_at;
                            existing_row.oauth_refresh_failed = false; // Clear failure flag
                            dure_info!("Updated OAuth tokens for existing domain: {}", domain);

                            // Save to config
                            Self::save_domain_to_config(
                                &profile.config_file,
                                provider,
                                domain,
                                zone_id,
                                account_id,
                                &platform_id,
                                access_token,
                                refresh_token,
                                expires_at,
                            );
                        } else {
                            // New domain: add to domain rows
                            self.domain_rows.push(DnsDomainRow {
                                provider: provider.clone(),
                                domain: domain.clone(),
                                status: DomainStatus::Configured,
                                platform_id: platform_id.clone(),
                                platform_name,
                                vm_name,
                                vm_external_ip,
                                account_id: account_id.clone(),
                                zone_id: zone_id.clone(),
                                oauth_access_token: access_token.clone(),
                                oauth_refresh_token: refresh_token.clone(),
                                oauth_token_expiry: *expires_at,
                                oauth_refresh_failed: false,
                                last_ns_check: None,
                                last_settings_check: None,
                                last_https_check: None,
                                operation_state: OperationState::Idle,
                                drawer_state: DnsDrawerState::default(),
                            });

                            // Save to config
                            Self::save_domain_to_config(
                                &profile.config_file,
                                provider,
                                domain,
                                zone_id,
                                account_id,
                                &platform_id,
                                access_token,
                                refresh_token,
                                expires_at,
                            );
                        }
                    }

                    self.show_add_dns_wizard = false;
                    self.dns_wizard = None;
                }
            }
        }

        // Poll NS check promise (unconditional - runs even when dialog closed)
        if let Some(promise) = self.ns_check_promise.take() {
            if let Some(result) = promise.ready() {
                match result {
                    Ok((check_result, display_results)) => {
                        self.ns_check_dialog.results = display_results.clone();
                        // Update domain row with check result and operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_ns_check = Some(check_result.clone());
                                row.operation_state = row.operation_state.clone().complete();
                                dure_info!("NS check completed for domain: {}", domain);
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                    Err((check_result, display_results)) => {
                        self.ns_check_dialog.results = display_results.clone();
                        // Store error result and update operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_ns_check = Some(check_result.clone());
                                let error_msg = check_result
                                    .error
                                    .clone()
                                    .unwrap_or_else(|| tr!("dns-error-unknown"));
                                row.operation_state =
                                    row.operation_state.clone().fail(error_msg.clone());
                                dure_warn!("NS check failed for domain {}: {}", domain, error_msg);
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                }
            } else {
                // Check timeout (30 seconds)
                if let Some(domain) = &self.selected_domain {
                    if let Some(row) = self.domain_rows.iter_mut().find(|r| &r.domain == domain) {
                        if let OperationState::InProgress { started_at, .. } = &row.operation_state
                        {
                            let now = chrono::Utc::now().timestamp();
                            if now - started_at > 30 {
                                row.operation_state =
                                    row.operation_state.clone().fail("Timeout after 30 seconds");
                                dure_warn!("NS check timed out for domain: {}", domain);
                                // Don't put promise back - let it die
                            } else {
                                ui.ctx().request_repaint();
                                self.ns_check_promise = Some(promise);
                            }
                        } else {
                            ui.ctx().request_repaint();
                            self.ns_check_promise = Some(promise);
                        }
                    } else {
                        ui.ctx().request_repaint();
                        self.ns_check_promise = Some(promise);
                    }
                } else {
                    ui.ctx().request_repaint();
                    self.ns_check_promise = Some(promise);
                }
            }
        }

        // NS check dialog
        self.ns_check_dialog.show(ui.ctx());

        // Poll DNS settings check promise (unconditional - runs even when dialog closed)
        if let Some(promise) = self.dns_settings_promise.take() {
            if let Some(result) = promise.ready() {
                match result {
                    Ok((check_result, display_msgs)) => {
                        self.dns_settings_result =
                            Some((check_result.clone(), display_msgs.clone()));
                        // Store result in domain row and update operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_settings_check = Some(check_result.clone());
                                row.oauth_refresh_failed = false; // Clear flag on success
                                row.operation_state = row.operation_state.clone().complete();
                                dure_info!("DNS settings check completed for domain: {}", domain);
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                    Err((check_result, display_msgs)) => {
                        self.dns_settings_result =
                            Some((check_result.clone(), display_msgs.clone()));
                        // Store error result in domain row and update operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_settings_check = Some(check_result.clone());
                                let error_msg = check_result
                                    .error
                                    .clone()
                                    .unwrap_or_else(|| "DNS check failed".to_string());

                                // Set oauth_refresh_failed flag if token refresh failed
                                row.oauth_refresh_failed = error_msg
                                    .contains("Token refresh failed")
                                    || error_msg.contains("OAuth token expired and refresh failed");

                                row.operation_state =
                                    row.operation_state.clone().fail(error_msg.clone());
                                dure_warn!(
                                    "DNS settings check failed for domain {}: {}",
                                    domain,
                                    error_msg
                                );
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                }
            } else {
                // Check timeout (30 seconds)
                if let Some(domain) = &self.selected_domain {
                    if let Some(row) = self.domain_rows.iter_mut().find(|r| &r.domain == domain) {
                        if let OperationState::InProgress { started_at, .. } = &row.operation_state
                        {
                            let now = chrono::Utc::now().timestamp();
                            if now - started_at > 30 {
                                row.operation_state =
                                    row.operation_state.clone().fail("Timeout after 30 seconds");
                                dure_warn!("DNS settings check timed out for domain: {}", domain);
                                // Don't put promise back - let it die
                            } else {
                                ui.ctx().request_repaint();
                                self.dns_settings_promise = Some(promise);
                            }
                        } else {
                            ui.ctx().request_repaint();
                            self.dns_settings_promise = Some(promise);
                        }
                    } else {
                        ui.ctx().request_repaint();
                        self.dns_settings_promise = Some(promise);
                    }
                } else {
                    ui.ctx().request_repaint();
                    self.dns_settings_promise = Some(promise);
                }
            }
        }

        // DNS settings check dialog with OAuth/create promise polling
        if self.show_dns_settings_dialog {
            // Poll DNS OAuth promise (dialog-only operation)
            if let Some(promise) = self.dns_oauth_promise.take() {
                if let Some(result) = promise.ready() {
                    match result {
                        Ok(oauth_result) => {
                            self.dns_oauth_result = Some(oauth_result.clone());
                            self.dns_operation_log.push(tr!("dns-oauth-success"));
                            // Update domain row with new OAuth tokens
                            if let Some(domain) = self.selected_domain.clone() {
                                self.update_domain_oauth_tokens(
                                    &domain,
                                    oauth_result.access_token.clone(),
                                    oauth_result.refresh_token.clone(),
                                    oauth_result.expires_at,
                                    profile,
                                );
                            }
                        }
                        Err(e) => {
                            self.dns_operation_log.push(format!("✗ {}", e));
                        }
                    }
                } else {
                    ui.ctx().request_repaint();
                    self.dns_oauth_promise = Some(promise);
                }
            }

            // Poll DNS create promise (dialog-only operation)
            if let Some(promise) = self.dns_create_promise.take() {
                if let Some(result) = promise.ready() {
                    match result {
                        Ok(()) => {
                            self.dns_operation_log.push(tr!("dns-create-success"));
                            // Trigger re-check
                            if let Some(domain) = self.selected_domain.clone() {
                                self.check_dns_settings(&domain, profile);
                            }
                        }
                        Err(e) => {
                            self.dns_operation_log.push(format!("✗ {}", e));
                        }
                    }
                } else {
                    ui.ctx().request_repaint();
                    self.dns_create_promise = Some(promise);
                }
            }

            let dns_settings_result = self.dns_settings_result.clone();
            let domain = self.selected_domain.clone();
            let has_oauth_token = domain
                .as_ref()
                .and_then(|d| self.domain_rows.iter().find(|r| &r.domain == d))
                .and_then(|r| r.oauth_access_token.clone())
                .or(self
                    .dns_oauth_result
                    .as_ref()
                    .map(|r| r.access_token.clone()))
                .is_some();

            let mut show_dialog = self.show_dns_settings_dialog;

            let window_width = ui.ctx().viewport_rect().width();
            let window_height = ui.ctx().viewport_rect().height();

            dialog(
                "dns_settings_check_dialog",
                &tr!("dns-settings-dialog-title"),
                &mut show_dialog,
            )
            .min_width(350.0)
            .max_width(window_width - 120.0)
            .max_height(window_height - 120.0)
            .scrollable(true)
            .content(|ui, open| {
                if let Some((check_result, display_msgs)) = &dns_settings_result {
                    ui.heading(&tr!("dns-settings-status-heading"));
                    ui.add_space(8.0);

                    // Show display messages (already contains status)
                    if !display_msgs.is_empty() {
                        ui.group(|ui| {
                            for msg in display_msgs {
                                ui.label(msg);
                            }
                        });
                    }

                    // Show missing records
                    if !check_result.missing_records.is_empty() {
                        ui.add_space(8.0);
                        ui.label(tr!("dns-settings-missing-label"));
                        ui.group(|ui| {
                            for record in &check_result.missing_records {
                                ui.label(format!("  • {}", record));
                            }
                        });
                    }

                    // Show fetched DNS records
                    if !check_result.fetched_records.is_empty() {
                        ui.add_space(8.0);
                        ui.label("Current DNS Records:");
                        ui.add_space(4.0);

                        egui::ScrollArea::vertical()
                            .max_height(200.0)
                            .show(ui, |ui| {
                                for record in &check_result.fetched_records {
                                    ui.monospace(format!(
                                        "{:<30} {:<8} {}",
                                        record.name, record.record_type, record.value
                                    ));
                                }
                            });
                    }

                    // Show error if any
                    if let Some(error) = &check_result.error {
                        use egui_material3::theme::get_global_color;
                        ui.add_space(8.0);
                        ui.colored_label(
                            get_global_color("error"),
                            tr!("dns-settings-error", {error: error}),
                        );

                        // Show authentication button if no OAuth token
                        if !has_oauth_token {
                            ui.add_space(8.0);
                            if ui
                                .add(MaterialButton::filled(tr!("dns-settings-auth-button")))
                                .clicked()
                            {
                                if let Some(domain) = &domain {
                                    self.start_dns_oauth(domain);
                                }
                            }
                        }
                    }

                    // Show Setup DNS button if authenticated and records missing
                    if has_oauth_token
                        && !check_result.records_valid
                        && !check_result.missing_records.is_empty()
                    {
                        ui.add_space(8.0);
                        ui.separator();
                        ui.add_space(8.0);

                        ui.label(tr!("dns-settings-setup-prompt"));
                        ui.add_space(4.0);

                        // DNS record preview (collect data first to avoid borrow conflicts)
                        let vm_ip_preview = domain
                            .as_ref()
                            .and_then(|d| self.domain_rows.iter().find(|r| &r.domain == d))
                            .and_then(|r| r.vm_external_ip.clone());

                        if let (Some(domain_str), Some(vm_ip)) = (&domain, &vm_ip_preview) {
                            ui.group(|ui| {
                                ui.label(format!("A    {}  →  {}", domain_str, vm_ip));
                                ui.label(format!(
                                    "CNAME    conference.{}  →  {}",
                                    domain_str, domain_str
                                ));
                                ui.label(format!(
                                    "SRV    _xmpp-client._tcp.{}  →  {}",
                                    domain_str, domain_str
                                ));
                                ui.label(format!(
                                    "SRV    _xmpp-server._tcp.{}  →  {}",
                                    domain_str, domain_str
                                ));
                            });
                        }

                        ui.add_space(8.0);

                        // Collect all needed data before button click handler
                        let setup_data = domain.as_ref().and_then(|d| {
                            self.domain_rows
                                .iter()
                                .find(|r| &r.domain == d)
                                .and_then(|row| {
                                    let zone_id = row.zone_id.clone()?;
                                    let vm_ip = row.vm_external_ip.clone()?;
                                    let token = row.oauth_access_token.clone().or(self
                                        .dns_oauth_result
                                        .as_ref()
                                        .map(|r| r.access_token.clone()))?;
                                    Some((d.clone(), zone_id, vm_ip, token))
                                })
                        });

                        if ui
                            .add(MaterialButton::filled(tr!("dns-settings-setup-button")))
                            .clicked()
                        {
                            if let Some((domain, zone_id, vm_ip, token)) = setup_data {
                                self.create_dns_records_for_domain(
                                    &domain, &zone_id, &vm_ip, &token,
                                );
                            }
                        }
                    }
                }

                // Show operation log if any
                if !self.dns_operation_log.is_empty() {
                    ui.add_space(12.0);
                    ui.separator();
                    ui.add_space(8.0);
                    ui.label(tr!("dns-settings-op-log-label"));
                    ui.group(|ui| {
                        for log_entry in &self.dns_operation_log {
                            ui.label(log_entry);
                        }
                    });
                }

                ui.add_space(12.0);
                ui.separator();
                ui.add_space(8.0);

                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
                    if ui.add(MaterialButton::filled(tr!("close"))).clicked() {
                        *open = false;
                    }
                });
            })
            .show(ui.ctx());

            self.show_dns_settings_dialog = show_dialog;
        }

        // Poll HTTPS check promise (unconditional - runs even when dialog closed)
        if let Some(promise) = self.https_check_promise.take() {
            if let Some(result) = promise.ready() {
                match result {
                    Ok(check_result) => {
                        self.https_check_result = Some(check_result.clone());
                        // Store result in domain row and update operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_https_check = Some(check_result.clone());
                                row.operation_state = row.operation_state.clone().complete();
                                dure_info!("HTTPS check completed for domain: {}", domain);
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                    Err(err) => {
                        let error_result = HttpsCheckResult {
                            checked_at: chrono::Utc::now().timestamp(),
                            resolves_to_vm: false,
                            resolved_ip: None,
                            expected_ip: None,
                            error: Some(err.clone()),
                        };
                        self.https_check_result = Some(error_result.clone());
                        // Store error result in domain row and update operation state
                        if let Some(domain) = &self.selected_domain {
                            if let Some(row) =
                                self.domain_rows.iter_mut().find(|r| &r.domain == domain)
                            {
                                row.last_https_check = Some(error_result);
                                row.operation_state = row.operation_state.clone().fail(err.clone());
                                dure_warn!("HTTPS check failed for domain {}: {}", domain, err);
                            }
                            // Save to config
                            self.save_check_results_to_config(domain, profile);
                        }
                    }
                }
            } else {
                // Check timeout (30 seconds)
                if let Some(domain) = &self.selected_domain {
                    if let Some(row) = self.domain_rows.iter_mut().find(|r| &r.domain == domain) {
                        if let OperationState::InProgress { started_at, .. } = &row.operation_state
                        {
                            let now = chrono::Utc::now().timestamp();
                            if now - started_at > 30 {
                                row.operation_state =
                                    row.operation_state.clone().fail("Timeout after 30 seconds");
                                dure_warn!("HTTPS check timed out for domain: {}", domain);
                                // Don't put promise back - let it die
                            } else {
                                ui.ctx().request_repaint();
                                self.https_check_promise = Some(promise);
                            }
                        } else {
                            ui.ctx().request_repaint();
                            self.https_check_promise = Some(promise);
                        }
                    } else {
                        ui.ctx().request_repaint();
                        self.https_check_promise = Some(promise);
                    }
                } else {
                    ui.ctx().request_repaint();
                    self.https_check_promise = Some(promise);
                }
            }
        }

        // HTTPS check dialog
        if self.show_https_check_dialog {
            let https_check_result = self.https_check_result.clone();

            let window_width = ui.ctx().viewport_rect().width();
            let window_height = ui.ctx().viewport_rect().height();

            dialog(
                "https_connection_check_dialog",
                tr!("dns-dialog-https-title"),
                &mut self.show_https_check_dialog,
            )
            .min_width(350.0)
            .max_width(window_width - 120.0)
            .max_height(window_height - 120.0)
            .scrollable(true)
            .content(|ui, open| {
                if let Some(result) = &https_check_result {
                    ui.heading(if result.resolves_to_vm {
                        tr!("dns-dialog-https-ok")
                    } else {
                        tr!("dns-dialog-https-mismatch")
                    });
                    ui.add_space(10.0);

                    ui.horizontal(|ui| {
                        ui.label(tr!("dns-dialog-https-resolved-ip"));
                        if let Some(ip) = &result.resolved_ip {
                            ui.label(ip);
                        } else {
                            ui.weak(tr!("dns-dialog-https-na"));
                        }
                    });

                    ui.horizontal(|ui| {
                        ui.label(tr!("dns-dialog-https-expected-ip"));
                        if let Some(ip) = &result.expected_ip {
                            ui.label(ip);
                        } else {
                            ui.weak(tr!("dns-dialog-https-na"));
                        }
                    });

                    ui.horizontal(|ui| {
                        ui.label(tr!("dns-dialog-https-matches-vm"));
                        if result.resolves_to_vm {
                            ui.label(tr!("dns-dialog-https-yes"));
                        } else {
                            ui.colored_label(
                                egui::Color32::from_rgb(255, 193, 7),
                                tr!("dns-dialog-https-no"),
                            );
                        }
                    });

                    if let Some(err_msg) = &result.error {
                        use egui_material3::theme::get_global_color;
                        ui.add_space(10.0);
                        ui.colored_label(
                            get_global_color("error"),
                            format!("{} {}", tr!("dns-dialog-https-error-prefix"), err_msg),
                        );
                    }
                } else {
                    ui.spinner();
                    ui.label(tr!("dns-dialog-https-checking"));
                }

                ui.add_space(12.0);
                ui.separator();
                ui.add_space(8.0);

                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
                    if ui.add(MaterialButton::filled(tr!("close"))).clicked() {
                        *open = false;
                    }
                });
            })
            .show(ui.ctx());
        }
    }

    /// Load platforms from config file
    fn load_platforms_from_config(
        config_file: &std::path::Path,
    ) -> Vec<crate::ui_dlg::dns_wizard::PlatformVmInfo> {
        let mut platforms = Vec::new();

        if let Ok(config) = crate::config::AppConfig::load(&config_file.to_path_buf()) {
            for (idx, platform_config) in config.platforms.iter().enumerate() {
                if let Some(vm) = platform_config.vms.first() {
                    let project_id = platform_config
                        .gcp_selected_project_id
                        .clone()
                        .or_else(|| Some(vm.gcp_project_id.clone()))
                        .unwrap_or_else(|| format!("project-{}", idx));

                    let platform_name = format!("Platform {} ({})", idx, project_id);

                    // Extract zone name from URL if needed (e.g., "zones/us-west1-a" -> "us-west1-a")
                    let zone = vm.zone.split('/').last().unwrap_or(&vm.zone).to_string();

                    platforms.push(crate::ui_dlg::dns_wizard::PlatformVmInfo {
                        project_id,
                        platform_name,
                        vm_name: vm.name.clone(),
                        vm_external_ip: vm.external_ip.clone().unwrap_or_default(),
                        zone,
                    });
                }
            }
        }

        platforms
    }

    /// Save DNS domain to config file
    fn save_domain_to_config(
        config_file: &std::path::Path,
        provider: &str,
        domain: &str,
        zone_id: &Option<String>,
        account_id: &Option<String>,
        platform_id: &Option<String>,
        access_token: &Option<String>,
        refresh_token: &Option<String>,
        expires_at: &Option<u64>,
    ) {
        use crate::config::{AppConfig, DnsDomainConfig};

        // Load config
        let mut config = AppConfig::load(&config_file.to_path_buf()).unwrap_or_default();

        // Check if domain already exists
        if config.dns_domains.iter().any(|d| &d.domain == domain) {
            dure_warn!("Domain {} already in config, skipping", domain);
            return;
        }

        // ponytail: OAuth tokens stored in plain YAML (like GCP)
        // Upgrade when: keyring crate available, but GCP already uses this pattern
        // Add new domain
        config.dns_domains.push(DnsDomainConfig {
            provider: provider.to_string(),
            domain: domain.to_string(),
            zone_id: zone_id.clone(),
            account_id: account_id.clone(),
            platform_id: platform_id.clone(),
            oauth_access_token: access_token.clone(),
            oauth_refresh_token: refresh_token.clone(),
            oauth_token_expiry: *expires_at,
            last_ns_check: None,
            last_settings_check: None,
            last_https_check: None,
        });

        // Save config
        if let Err(e) = config.save(&config_file.to_path_buf()) {
            dure_error!("Failed to save DNS domain to config: {}", e);
        } else {
            dure_info!("Saved DNS domain {} with OAuth tokens to config", domain);
        }
    }

    /// Delete DNS domain from config and memory
    fn delete_domain(&mut self, domain: &str, profile: &ProfileContext) {
        use crate::config::AppConfig;

        dure_info!("Deleting DNS domain: {}", domain);

        // Remove from memory
        self.domain_rows.retain(|row| row.domain != domain);

        // Remove from config file
        let mut config = AppConfig::load(&profile.config_file).unwrap_or_default();

        let original_count = config.dns_domains.len();
        config.dns_domains.retain(|d| &d.domain != domain);

        if config.dns_domains.len() < original_count {
            if let Err(e) = config.save(&profile.config_file) {
                dure_error!("Failed to save config after deleting domain: {}", e);
            } else {
                dure_info!("Successfully deleted DNS domain {} from config", domain);
            }
        } else {
            dure_warn!("Domain {} not found in config", domain);
        }
    }

    /// Load DNS domains from config file
    #[cfg(not(target_arch = "wasm32"))]
    fn load_domain_rows(&mut self, profile: &ProfileContext) {
        use crate::config::AppConfig;

        // Clear existing rows
        self.domain_rows.clear();

        // Load config
        let config = match AppConfig::load(&profile.config_file) {
            Ok(config) => config,
            Err(e) => {
                dure_warn!("Failed to load config for DNS domains: {}", e);
                self.loaded = true;
                return;
            }
        };

        // Convert DnsDomainConfig to DnsDomainRow
        for dns_config in &config.dns_domains {
            // Lookup platform info from config if platform_id is set
            let (platform_id, platform_name, vm_name, vm_external_ip) =
                if let Some(pid) = &dns_config.platform_id {
                    let platforms = Self::load_platforms_from_config(&profile.config_file);
                    platforms
                        .iter()
                        .find(|p| &p.project_id == pid)
                        .map(|p| {
                            (
                                Some(p.project_id.clone()),
                                Some(p.platform_name.clone()),
                                Some(p.vm_name.clone()),
                                Some(p.vm_external_ip.clone()),
                            )
                        })
                        .unwrap_or_else(|| (Some(pid.clone()), None, None, None))
                } else {
                    (None, None, None, None)
                };

            self.domain_rows.push(DnsDomainRow {
                provider: dns_config.provider.clone(),
                domain: dns_config.domain.clone(),
                status: DomainStatus::Configured,
                platform_id,
                platform_name,
                vm_name,
                vm_external_ip,
                account_id: dns_config.account_id.clone(),
                zone_id: dns_config.zone_id.clone(),
                oauth_access_token: dns_config.oauth_access_token.clone(),
                oauth_refresh_token: dns_config.oauth_refresh_token.clone(),
                oauth_token_expiry: dns_config.oauth_token_expiry,
                oauth_refresh_failed: false,
                last_ns_check: dns_config.last_ns_check.clone(),
                last_settings_check: dns_config.last_settings_check.clone(),
                last_https_check: dns_config.last_https_check.clone(),
                operation_state: OperationState::Idle,
                drawer_state: DnsDrawerState::default(),
            });
        }

        dure_debug!("Loaded {} DNS domains from config", self.domain_rows.len());

        // Check token expiry for each domain and set oauth_refresh_failed flag
        let config_path = profile.config_file.clone();
        for row in &mut self.domain_rows {
            if let (Some(expiry), Some(refresh_token)) =
                (row.oauth_token_expiry, row.oauth_refresh_token.as_ref())
            {
                let now = chrono::Utc::now().timestamp() as u64;
                if now > expiry {
                    dure_debug!(
                        "Token expired for domain {} - attempting refresh on load",
                        row.domain
                    );

                    // Attempt token refresh
                    match refresh_oauth_token_standalone(&row.domain, refresh_token, &config_path) {
                        Ok((new_access, new_expiry, new_refresh)) => {
                            dure_info!("✓ Token auto-refreshed on load for domain: {}", row.domain);
                            row.oauth_access_token = Some(new_access);
                            row.oauth_token_expiry = Some(new_expiry);
                            row.oauth_refresh_token = Some(new_refresh);
                            row.oauth_refresh_failed = false;
                        }
                        Err(e) => {
                            dure_warn!(
                                "Token refresh failed on load for domain {}: {}",
                                row.domain,
                                e
                            );
                            row.oauth_refresh_failed = true; // Set flag immediately
                        }
                    }
                }
            }
        }

        self.loaded = true;
    }

    /// WASM stub for load_domain_rows
    #[cfg(target_arch = "wasm32")]
    fn load_domain_rows(&mut self, _profile: &ProfileContext) {
        self.loaded = true;
    }

    /// Save DNS check results to config
    #[cfg(not(target_arch = "wasm32"))]
    fn save_check_results_to_config(&self, domain: &str, profile: &ProfileContext) {
        use crate::config::AppConfig;

        let mut config = match AppConfig::load(&profile.config_file) {
            Ok(c) => c,
            Err(e) => {
                dure_error!("Failed to load config for saving check results: {}", e);
                return;
            }
        };

        // Find domain row with check results
        let row = match self.domain_rows.iter().find(|r| r.domain == domain) {
            Some(r) => r,
            None => return,
        };

        // Update config with check results
        if let Some(dns_config) = config.dns_domains.iter_mut().find(|d| &d.domain == domain) {
            dns_config.last_ns_check = row.last_ns_check.clone();
            dns_config.last_settings_check = row.last_settings_check.clone();
            dns_config.last_https_check = row.last_https_check.clone();

            if let Err(e) = config.save(&profile.config_file) {
                dure_error!("Failed to save DNS check results to config: {}", e);
            } else {
                dure_debug!("Saved DNS check results for {} to config", domain);
            }
        }
    }

    /// WASM stub for save_check_results_to_config
    #[cfg(target_arch = "wasm32")]
    fn save_check_results_to_config(&self, _domain: &str, _profile: &ProfileContext) {
        // No-op on WASM
    }

    /// Rotate OAuth client secret for domain
    /// This is useful when the secret may have been compromised or for regular rotation policy
    #[cfg(not(target_arch = "wasm32"))]
    fn rotate_oauth_secret(&mut self, domain: &str, profile: &ProfileContext) {
        dure_info!("Rotating OAuth secret for domain: {}", domain);

        if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
            row.operation_state = OperationState::start("Rotating OAuth secret");

            // Get current access token and account ID
            let token = match &row.oauth_access_token {
                Some(t) => t.clone(),
                None => {
                    row.operation_state =
                        row.operation_state.clone().fail("No OAuth token available");
                    dure_error!("Cannot rotate secret: No OAuth token for domain {}", domain);
                    return;
                }
            };

            let account_id = match &row.account_id {
                Some(id) => id.clone(),
                None => {
                    row.operation_state = row.operation_state.clone().fail("No account ID");
                    dure_error!("Cannot rotate secret: No account ID for domain {}", domain);
                    return;
                }
            };

            let domain = domain.to_string();
            let config_path = profile.config_file.clone();

            // Get client ID from environment (same as used in OAuth flow)
            let client_id = std::env::var("CLOUDFLARE_OAUTH_CLIENT_ID")
                .unwrap_or_else(|_| "47d31be581def48e92dbce05745335c3".to_string());

            // Note: For PKCE OAuth (no client secret), rotation may not apply
            // This function is here for completeness, but Cloudflare PKCE OAuth
            // doesn't use client secrets - only authorization codes and refresh tokens
            dure_warn!("Secret rotation requested for domain {}, but PKCE OAuth doesn't use client secrets", domain);
            dure_info!("For PKCE OAuth, consider re-authenticating instead of rotating secrets");

            // Mark operation as complete with info message
            if let Some(row) = self.domain_rows.iter_mut().find(|r| r.domain == domain) {
                row.operation_state = row.operation_state.clone().complete();
            }
        }
    }

    /// WASM stub for rotate_oauth_secret
    #[cfg(target_arch = "wasm32")]
    fn rotate_oauth_secret(&mut self, _domain: &str, _profile: &ProfileContext) {
        // No-op on WASM
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::path::PathBuf;

    // Helper to create mock ProfileContext for tests
    fn mock_profile() -> ProfileContext {
        ProfileContext {
            name: "test".to_string(),
            config_dir: PathBuf::from("/tmp/test-config"),
            data_dir: PathBuf::from("/tmp/test-data"),
            config_file: PathBuf::from("/tmp/test-config/config.yml"),
            settings_file: PathBuf::from("/tmp/test-config/settings.yml"),
            db_path: PathBuf::from("/tmp/test-data/dure.db"),
            kdbx_path: PathBuf::from("/tmp/test-config/key.kdbx"),
            kpkey_path: PathBuf::from("/tmp/test-config/id_ed25519"),
            kppubkey_path: PathBuf::from("/tmp/test-config/id_ed25519.pub"),
        }
    }

    #[test]
    fn test_refresh_oauth_token_standalone_success() {
        // This test verifies the token refresh helper function signature
        // Actual refresh requires valid Cloudflare credentials
        // The function is tested via integration tests with real API

        // Just verify function exists and returns expected type
        let result = refresh_oauth_token_standalone(
            "test.domain",
            "", // Empty refresh token
            &PathBuf::from("/tmp/test.yml"),
        );

        // Should fail with empty refresh token
        assert!(result.is_err());
        assert!(result.unwrap_err().contains("No refresh token"));
    }

    #[test]
    fn test_dns_drawer_state_default() {
        let state = DnsDrawerState::default();
        assert_eq!(state.active_tab, DnsDrawerTab::Status);
        assert!(state.logs.is_empty());
        assert!(state.operations.is_empty());
        assert!(!state.loading);
    }

    #[test]
    fn test_dns_drawer_state_new() {
        let state = DnsDrawerState::new();
        assert_eq!(state.active_tab, DnsDrawerTab::Status);
        assert!(state.logs.is_empty());
        assert!(state.operations.is_empty());
        assert!(!state.loading);
    }

    #[test]
    fn test_dns_drawer_state_switch_tab() {
        let mut state = DnsDrawerState::new();
        assert_eq!(state.active_tab, DnsDrawerTab::Status);

        state.switch_tab(DnsDrawerTab::Logs);
        assert_eq!(state.active_tab, DnsDrawerTab::Logs);

        state.switch_tab(DnsDrawerTab::Operations);
        assert_eq!(state.active_tab, DnsDrawerTab::Operations);
    }

    #[test]
    fn test_dns_drawer_state_set_logs() {
        let mut state = DnsDrawerState::new();
        state.loading = true;

        let logs = vec!["log1".to_string(), "log2".to_string()];
        state.set_logs(logs.clone());

        assert_eq!(state.logs, logs);
        assert!(!state.loading, "set_logs should clear loading flag");
    }

    #[test]
    fn test_dns_drawer_state_set_operations() {
        let mut state = DnsDrawerState::new();
        state.loading = true;

        let ops = vec![];
        state.set_operations(ops);

        assert!(state.operations.is_empty());
        assert!(!state.loading, "set_operations should clear loading flag");
    }

    #[test]
    fn test_dns_drawer_state_set_loading() {
        let mut state = DnsDrawerState::new();
        assert!(!state.loading);

        state.set_loading(true);
        assert!(state.loading);

        state.set_loading(false);
        assert!(!state.loading);
    }

