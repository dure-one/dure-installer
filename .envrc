# direnv configuration for Dure project
#
# This file automatically loads environment variables when you cd into the project.
# Install direnv: https://direnv.net/
#
# Usage:
#   1. Install direnv (pkg_add direnv on OpenBSD)
#   2. Add 'eval "$(direnv hook bash)"' to your ~/.bashrc
#   3. Run 'direnv allow' in this directory

# OpenBSD: Use OpenSSL 3.5.7 instead of LibreSSL
if [[ "$(uname -s)" == "OpenBSD" ]]; then
    export OPENSSL_LIB_DIR="/usr/local/lib/eopenssl35"
    export OPENSSL_INCLUDE_DIR="/usr/local/include/eopenssl35"
    echo "OpenBSD detected: Using OpenSSL 3.5.7 (eopenssl35)"
fi
